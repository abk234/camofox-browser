# Copy to scripts/camofox-app.env and adjust as needed.
# scripts/camofox-app.env is gitignored.

# Run mode: host (npm/node) or docker (make up)
RUN_MODE=host

# API port (host + docker publish)
CAMOFOX_PORT=9377

# Loopback-only bind; LAN access via camofox-lan-proxy.py
CAMOFOX_BIND_HOST=127.0.0.1

# App data (cookies, profiles, traces) — default matches upstream ~/.camofox
CAMOFOX_HOME=$HOME/.camofox

# Telemetry (app-documented opt-out)
CAMOFOX_CRASH_REPORT_ENABLED=false

# Optional auth (cookie import / global access)
# CAMOFOX_API_KEY=
# CAMOFOX_ACCESS_KEY=
# CAMOFOX_ADMIN_KEY=

# LAN proxy (host TCP → loopback). Separate listen port avoids macOS
# dual-bind conflicts when the server is on 127.0.0.1:CAMOFOX_PORT.
ENABLE_LAN_PROXY=true
CAMOFOX_LAN_PORT=19377

# Backups of CAMOFOX_HOME + local env
BACKUP_DIR=../camofox-backups
BACKUP_INTERVAL_DAYS=30
BACKUP_KEEP=3

# On update: merge upstream/master before reinstall/restart
UPDATE_SYNC_ON_UPDATE=true

# Docker image tag bits (only when RUN_MODE=docker; passed to make)
# ARCH=aarch64
# VERSION=135.0.1
# RELEASE=beta.24
